<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <xacro:include filename="inertial_macros.xacro" />
    <!--Including all colors to be used-->
    <material name="white">
        <color rgba="1 1 1 1" />
    </material>
    <material name="blue">
        <color rgba="0.2 0.2 1 1" />
    </material>
    <material name="orange">
        <color rgba="1 0.3 0.1 1" />
    </material>
    <material name="black">
        <color rgba="0 0 0 1" />
    </material>

    <!--Including the base link-->
    <link name="base_link">
        <xacro:inertial_box mass="1.0" x="0.01" y="0.01" z="0.01">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_box>
    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link" />
        <child link="chassis" />
        <origin xyz="0 0 0.025" />
    </joint>

    <link name="chassis">

        <!-- Center box -->
        <visual>
            <origin xyz="0 0 0" />
            <geometry>
                <box size="0.13 0.12 0.03" />
            </geometry>
            <material name="orange" />
        </visual>

        <!-- Front rounded end -->
        <visual>
            <origin xyz="0.065 0 0" />
            <geometry>
                <cylinder radius="0.06" length="0.03" />
            </geometry>
            <material name="orange" />
        </visual>

        <!-- Rear rounded end -->
        <visual>
            <origin xyz="-0.065 0 0" />
            <geometry>
                <cylinder radius="0.06" length="0.03" />
            </geometry>
            <material name="orange" />
        </visual>
        <collision>
            <origin xyz="0 0 0" />
            <geometry>
                <box size="0.13 0.12 0.03" />
            </geometry>
        </collision>

        <collision>
            <origin xyz="0.065 0 0" />
            <geometry>
                <cylinder radius="0.06" length="0.03" />
            </geometry>
        </collision>

        <collision>
            <origin xyz="-0.065 0 0" />
            <geometry>
                <cylinder radius="0.06" length="0.03" />
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.5" x="0.25" y="0.12" z="0.03">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_box>
    </link>
    <!--Joints and links for the rear wheels-->
    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="rear_left_wheel" />
        <origin xyz="-0.10 0.078 0" rpy="-${pi/2} 0 0" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="rear_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.025" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.025" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.025" radius="0.03">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="rear_left_wheel">
        <mu1 value="1.0" />
        <mu2 value="1.0" />
    </gazebo>

    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="rear_right_wheel" />
        <origin xyz="-0.10 -0.078 0" rpy="${pi/2} 0 0" />
        <axis xyz="0 0 -1" />
    </joint>

    <link name="rear_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.025" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.025" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.03" radius="0.025">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="rear_right_wheel">
        <mu1 value="1.0" />
        <mu2 value="1.0" />
    </gazebo>

    <!--Joint and links for the front wheels-->
    <link name="front_left_steer_link">
        <visual>
            <geometry>
                <box size="0.01 0.01 0.01" />
            </geometry>
        </visual>
        <xacro:inertial_box mass="0.01" x="0.01" y="0.01" z="0.01">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_box>
    </link>

    <joint name="front_left_steer_joint" type="revolute">
        <parent link="base_link" />
        <child link="front_left_steer_link" />
        <limit lower="-0.6" upper="0.6" effort="10" velocity="1" />
        <origin xyz="0.10 0.078 0" />
        <axis xyz="0 0 1" />
    </joint>

    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="front_left_steer_link" />
        <child link="front_left_wheel" />
        <origin rpy="-${pi/2} 0 0" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="front_left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.025" />
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.025" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.03" radius="0.025">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="front_left_wheel">
        <mu1 value="1.0" />
        <mu2 value="1.0" />
    </gazebo>

    <link name="front_right_steer_link">
        <visual>
            <geometry>
                <box size="0.01 0.01 0.01" />
            </geometry>
        </visual>
        <xacro:inertial_box mass="0.01" x="0.01" y="0.01" z="0.01">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_box>
    </link>

    <joint name="front_right_steer_joint" type="revolute">
        <parent link="base_link" />
        <child link="front_right_steer_link" />
        <limit lower="-0.6" upper="0.6" effort="10" velocity="1" />
        <origin xyz="0.10 -0.078 0" />
        <axis xyz="0 0 1" />
    </joint>

    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="front_right_steer_link" />
        <child link="front_right_wheel" />
        <origin rpy="${pi/2} 0 0" />
        <axis xyz="0 0 -1" />
    </joint>

    <link name="front_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.025" />
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.025" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.03" radius="0.025">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="front_right_wheel">
        <mu1 value="1.0" />
        <mu2 value="1.0" />
    </gazebo>

    <gazebo>
        <!-- Including the ackermann plugin from  gazebo for the ackermann movement -->
        <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>rear_right_wheel_joint</right_joint>

            <left_steering_joint>front_left_steer_joint</left_steering_joint>
            <right_steering_joint>front_right_steer_joint</right_steering_joint>

            <wheel_base>0.16</wheel_base>
            <wheel_separation>0.17</wheel_separation>
            <wheel_radius>0.04</wheel_radius>

            <steering_limit>0.6</steering_limit>
            <topic>/model/midsem_robot/cmd_vel</topic>
            <odom_publish_frequency>30</odom_publish_frequency>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
        </plugin>
    </gazebo>

</robot>